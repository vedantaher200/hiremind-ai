{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/ai",
      "destination": "/api/ai"
    },
    {
      "source": "/api/admin-setup",
      "destination": "/api/admin-setup"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
