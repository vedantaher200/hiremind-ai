# ========================================================
# HIREMIND AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# --------------------------------------------------------
# CLIENT VARIABLES (Vite Frontend - Browser Safe)
# Required in production on Vercel
# --------------------------------------------------------
# Supabase project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=""

# Supabase anon / public API key
VITE_SUPABASE_ANON_KEY=""

# Public browser URL used for email confirmation & redirects
# Local: http://localhost:3000 | Vercel: https://hiremind-ai-pearl.vercel.app
VITE_APP_URL="https://hiremind-ai-pearl.vercel.app"

# Optional custom API base URL (leave blank to default to /api for same-origin Vercel deployment)
VITE_API_URL=""

# Google Identity Services OAuth client ID (must match the server's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=""

# --------------------------------------------------------
# SERVER VARIABLES (Vercel Serverless / Backend - Never expose to frontend!)
# --------------------------------------------------------
# Supabase server URL (used by /api/ai and /api/admin-setup)
SUPABASE_URL=""

# Supabase server anon key
SUPABASE_ANON_KEY=""

# Supabase Service Role Key (Admin privileges, used strictly server-side for admin provisioning)
SUPABASE_SERVICE_ROLE_KEY=""

# Google Gemini API key for ATS resume analysis and intelligence features
GEMINI_API_KEY=""

# Secret key used for signing internal tokens if standalone server is used
JWT_SECRET=""

# Allowed client URL for CORS
CLIENT_URL="https://hiremind-ai-pearl.vercel.app"

# Admin setup key for initial controlled platform administrator registration
ADMIN_SETUP_KEY=""

# Optional: Google OAuth Client ID for real Google Identity verification
GOOGLE_CLIENT_ID=""
