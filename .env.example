# Server-only Gemini key. Never use VITE_GEMINI_API_KEY.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public browser URL used for Supabase email confirmation and password-reset links.
# Local example: http://localhost:3000 | Production: https://your-app.vercel.app
VITE_APP_URL="http://localhost:3000"

# Supabase Configuration (Optional: App falls back to high-fidelity persistent local storage & seed database when unconfigured)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-side equivalents used by /api/ai to validate signed-in users.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Server-only; never expose this key through a VITE_ variable.
# SUPABASE_SERVICE_ROLE_KEY=""

# Server-only Admin Setup Key (used by Express backend in server/.env)
# Never expose to the browser bundle (never use VITE_ADMIN_SETUP_KEY).
ADMIN_SETUP_KEY=""
